# Every setting the connect PoC reads. Copy this file to .env and change what you need:
#
#     cp dev/connect-poc/.env.example dev/connect-poc/.env
#
# A real environment variable always wins over this file. The docker compose service sets the first
# four itself, so with docker you only need this file to override something.

###
# Required
###

# The shop's own https base URL, no query and no fragment. MyParcel returns the merchant's browser
# to this URL plus /myparcel-connect/callback, so it has to work in their browser. With the docker
# compose service, this is set for you from CONNECT_POC_HOST.
MYPARCEL_CONNECT_SHOP_URL=https://connect-poc.dev.myparcel.nl

# Encrypts the private key and the access token before the SDK hands them to your storage. Any
# string works. Keep the same one for as long as state.json exists, because a different key makes
# that file unreadable. In a real integration, keep this out of the database.
MYPARCEL_CONNECT_KEY=connect-poc-local-only

###
# Optional, shown with their defaults
###

# Which platform you connect as. It decides which e-commerce service the SDK calls. See
# ConnectPlatform for the values the SDK accepts. Leave it unset to use the first of those.
MYPARCEL_CONNECT_PLATFORM=SHOPIFY

# Which MyParcel environment to use: acceptance, or production. Acceptance is the test environment.
MYPARCEL_CONNECT_ENV=acceptance

# The shop title the merchant sees at MyParcel while connecting. 1 to 64 characters.
MYPARCEL_CONNECT_SHOP_NAME=Connect PoC

# The backoffice this page links to. Defaults to the backoffice matching MYPARCEL_CONNECT_ENV.
# Not an SDK setting: only this page uses it.
MYPARCEL_BACKOFFICE_URL=

###
# Read by docker compose, not by this page
###

# The host traefik serves the page on, which also becomes MYPARCEL_CONNECT_SHOP_URL. Keep it under
# a domain the traefik certificate covers, such as any name ending in .dev.myparcel.nl.
#
# docker compose reads the .env next to docker-compose.yml, so this one belongs in the repository
# root, not in this file.
#
# The docker config already carrier the domain below as its default, you usually don't need to change it.
# CONNECT_POC_HOST=connect-poc.dev.myparcel.nl
