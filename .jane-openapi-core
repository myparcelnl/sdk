            'directory' => __DIR__ . '/src/Client/Generated/Jane/OrderApi',
        ],
    ],
    // Generate validators, so the client checks a request against the spec before it sends it.
    // Jane also validates each response: a new field in a schema with `additionalProperties: false`,
    // or a new enum value, throws a ValidationException. So a client must read with the
    // skip_validation context.
    'validation' => true,
    // Generate the enums of the spec as PHP enums.
    'enums-as-objects' => true,
    // Read an enum value that the SDK does not know as the raw value, a string or an int, so a new
    // value in the API, such as a new carrier, does not break a read. This works only when the read
    // skips the validation: the generated validators have a Choice constraint with the known values.
    'enums-unknown-value' => 'scalar',
    // Send a required field only when it is set. A missing field then throws a ValidationException,
    // not a PHP Error for a property that is not initialized.
    'skip-required-fields' => true,
    // Send an optional field when it is set, also when it is null. So a model can send null for a
    // field that the API accepts as null, such as `pickup`. A field that nobody set stays out.
    'include-null-value' => false,
    // A date property takes every DateTimeInterface, such as DateTimeImmutable.
    'date-prefer-interface' => true,
    // The date formats stay the Jane defaults, `Y-m-d\TH:i:sP` and `Y-m-d`. The Core API and IAM
    // specs type their dates as strings, and the Order API sends its dates in the default format.
    // Jane loads the specs from myparcel.nl URLs, and it refuses a remote URL by default. Allow one
    // only on myparcel.nl, without redirects.
    'allow-external-refs' => true,
    'external-ref-allowed-hosts' => ['myparcel.nl'],
    'external-ref-follow-redirects' => false,
