{
    "name": "myparcelnl/sdk",
    "version": "12.0.0-beta.7",
    "description": "This package is designed to send and receive data from MyParcel by means of an API.",
    "keywords": [
        "MyParcel",
        "PostNL"
    ],
    "homepage": "https://myparcelnl.github.io/sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "MyParcel External Integrations",
            "email": "support@myparcel.nl"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit --coverage-html coverage"
        ],
        "generate:api": [
            "docker compose run --rm generate-api",
            "docker compose run --rm php vendor/bin/jane-openapi generate",
            "docker compose run --rm php vendor/bin/jane-openapi generate --config-file=.jane-openapi-core",
            "composer dump-autoload -o"
        ]
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "jane-php/open-api-runtime": "^8.0",
        "symfony/serializer": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0",
        "gapple/structured-fields": "^2.3",
        "firebase/php-jwt": "^7.2"
    },
    "suggest": {
        "ext-openssl": "Required for MyParcel Connect and for verifying the commands MyParcel sends. Nothing else in the SDK needs it."
    },
    "require-dev": {
        "fakerphp/faker": "^v1.16.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^9.6.22",
        "psr/container": "~2.0.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jane-php/open-api-3-1": "^8.1",
        "jane-php/open-api-common": "^8.1",
        "jane-php/json-schema": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "MyParcelNL\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyParcelNL\\Sdk\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
